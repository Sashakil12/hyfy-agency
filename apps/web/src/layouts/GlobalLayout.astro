---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
  showNav?: boolean
  canonicalUrl?: string
}

const { title, description, image, showNav = true, canonicalUrl } = Astro.props
const siteUrl = 'https://dev.hyfy.ltd'
const ogImage = image || '/og-default.png'
const canonical = canonicalUrl || Astro.url.href
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description || "Hyfy Agency - Digital Transformation Experts"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Hyfy Agency - Digital Transformation Experts"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Hyfy Agency" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || "Hyfy Agency - Digital Transformation Experts"} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Hyfy Agency",
      "url": "https://dev.hyfy.ltd",
      "logo": "https://dev.hyfy.ltd/logo.png",
      "description": "Full-stack development agency with AI-assisted workflows. Build custom ERPs, AI-native apps, SaaS products, and e-commerce platforms 65% faster to MVP.",
      "sameAs": [
        "https://twitter.com/hyfyagency",
        "https://linkedin.com/company/hyfyagency"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "url": "https://dev.hyfy.ltd/contact"
      }
    })} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2KXV67YC53"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2KXV67YC53');
    </script>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Orbitron:wght@400;500;600;700&family=Rajdhani:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#050505] text-white min-h-screen">
    <slot name="header" />

    <!-- Content with padding for fixed header -->
    <main class={showNav ? "pt-20" : ""}>
      <slot />
    </main>

    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }

      .font-orbitron {
        font-family: 'Orbitron', sans-serif;
      }

      .font-rajdhani {
        font-family: 'Rajdhani', sans-serif;
      }
    </style>
  </body>
</html>
