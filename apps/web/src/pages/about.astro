---
import GlobalLayout from '../layouts/GlobalLayout.astro'
import GlobalHeader from '../components/GlobalHeader'
import { AboutHeroSection } from '@/components/sections/AboutHeroSection'
import { MissionSection } from '@/components/sections/MissionSection'
import { StatsSection } from '@/components/sections/StatsSection'
import { TeamSection } from '@/components/sections/TeamSection'
import { ProcessSection } from '@/components/sections/ProcessSection'
import { AboutCTASection } from '@/components/sections/AboutCTASection'
import { Footer } from '@/components/Footer'
---

<GlobalLayout 
	title="About Us - Hyfy Agency - AI-Powered Full-Stack Development"
	description="Meet the team behind Hyfy Agency. We're AI-powered developers building custom software 65% faster. Learn our mission, values, and how we work."
>
	<GlobalHeader client:load slot="header" currentPath="/about" />
	<AboutHeroSection client:load />
	<MissionSection client:load />
	<StatsSection client:load />
	<TeamSection client:load />
	<ProcessSection client:load />
	<AboutCTASection client:load />
	<Footer client:load />
</GlobalLayout>
