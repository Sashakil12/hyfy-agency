---
import GlobalLayout from '../layouts/GlobalLayout.astro'
import { HeroSection } from '@/components/sections/HeroSection'
import { JourneySection } from '@/components/sections/JourneySection'
import { ExpertiseSection } from '@/components/sections/ExpertiseSection'
import { SocialProofSection } from '@/components/sections/SocialProofSection'
import { ProcessSection } from '@/components/sections/ProcessSection'
import { CTASection } from '@/components/sections/CTASection'
import { Footer } from '@/components/Footer'
---

<GlobalLayout 
	title="Hyfy Agency - From Idea to MVP in 65% Less Time"
	description="Full-stack development agency with AI-assisted workflows. Build custom ERPs, AI-native apps, SaaS products, and e-commerce platforms 65% faster to MVP."
	showNav={false}
>
	<HeroSection client:load />
	<JourneySection client:load />
	<ExpertiseSection client:load />
	<SocialProofSection client:load />
	<ProcessSection client:load />
	<CTASection client:load />
	<Footer client:load />
</GlobalLayout>
