---
import GlobalLayout from '../layouts/GlobalLayout.astro'
import GlobalHeader from '../components/GlobalHeader'
import { N8nHeroSection } from '@/components/sections/N8nHeroSection'
import { N8nFeaturesSection } from '@/components/sections/N8nFeaturesSection'
import { N8nCTASection } from '@/components/sections/N8nCTASection'
import { Footer } from '@/components/Footer'
---

<GlobalLayout 
	title="n8n Services | Hyfy Agency - Custom Workflow Automation"
	description="Expert n8n services: custom workflow development, setup, training, and custom node development. We build automations that save you time."
>
	<GlobalHeader client:load slot="header" currentPath="/n8n" />
	<N8nHeroSection client:load />
	<N8nFeaturesSection client:load />
	<N8nCTASection client:load />
	<Footer client:load />
</GlobalLayout>
