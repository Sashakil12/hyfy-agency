---
import GlobalLayout from '../layouts/GlobalLayout.astro'
import GlobalHeader from '../components/GlobalHeader'
import { EcommerceHeroSection } from '@/components/sections/EcommerceHeroSection'
import { EcommerceFeaturesSection } from '@/components/sections/EcommerceFeaturesSection'
import { EcommerceStackSection } from '@/components/sections/EcommerceStackSection'
import { CaseStudySection } from '@/components/sections/CaseStudySection'
import { EcommerceCTASection } from '@/components/sections/EcommerceCTASection'
import { Footer } from '@/components/Footer'
import { caseStudies } from '@/data/caseStudies'

const ecommerceStudies = caseStudies.filter((s) =>
	['hyfy', 'pos26'].includes(s.slug)
)
---

<GlobalLayout 
	title="Custom Ecommerce Development | Hyfy Agency - Headless Commerce Solutions"
	description="Custom headless ecommerce solutions with 3x faster load times and 40% higher conversion rates. Shopify Plus, Commerce.js, and custom builds. Go beyond template limitations."
>
	<GlobalHeader client:load slot="header" currentPath="/ecommerce" />
	<EcommerceHeroSection client:load />
	<EcommerceFeaturesSection client:load />
	<EcommerceStackSection client:load />
	<CaseStudySection
		client:load
		label="Case_Study // ECOMMERCE_IN_PRODUCTION"
		heading="Storefronts"
		headingAccent="That Convert"
		description="Production e-commerce platforms — cross-border pricing engines, landed-cost calculators, and multi-seller aggregation."
		studies={ecommerceStudies}
	/>
	<EcommerceCTASection client:load />
	<Footer client:load />
</GlobalLayout>
