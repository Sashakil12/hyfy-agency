---
import GlobalLayout from '../layouts/GlobalLayout.astro'
import GlobalHeader from '../components/GlobalHeader'
import { ErpHeroSection } from '@/components/sections/ErpHeroSection'
import { ErpFeaturesSection } from '@/components/sections/ErpFeaturesSection'
import { ErpIndustriesSection } from '@/components/sections/ErpIndustriesSection'
import { ErpCTASection } from '@/components/sections/ErpCTASection'
import { Footer } from '@/components/Footer'
---

<GlobalLayout 
	title="Custom ERP Solutions | Hyfy Agency - Intuitive Systems for Blue-Collar Teams"
	description="Custom ERP systems designed for blue-collar workforces. Mobile-first interfaces, intuitive workflows, 90% user adoption rate. Manufacturing, construction, logistics expertise."
>
	<GlobalHeader client:load slot="header" currentPath="/erp" />
	<ErpHeroSection client:load />
	<ErpFeaturesSection client:load />
	<ErpIndustriesSection client:load />
	<ErpCTASection client:load />
	<Footer client:load />
</GlobalLayout>
