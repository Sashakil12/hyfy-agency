---
import GlobalLayout from '../layouts/GlobalLayout.astro'
import GlobalHeader from '../components/GlobalHeader'
import { ContactHeroSection } from '@/components/sections/ContactHeroSection'
import { ContactFormSection } from '@/components/sections/ContactFormSection'
import { ContactInfoSection } from '@/components/sections/ContactInfoSection'
import { Footer } from '@/components/Footer'
---

<GlobalLayout 
	title="Contact Us - Hyfy Agency - Start Your Project"
	description="Get in touch with Hyfy Agency. Book a free strategy call to discuss your project. We respond within 48 hours."
>
	<GlobalHeader client:load slot="header" currentPath="/contact" />
	<ContactHeroSection client:load />
	<ContactFormSection client:load />
	<ContactInfoSection client:load />
	<Footer client:load />
</GlobalLayout>
